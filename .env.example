# cp .env.example .env して値を入れる（.env は git に入らない）。API キーはここに書かず secret run で渡す。

# 推論: nosana / vertex（未指定なら NOSANA_BASE_URL があれば nosana、GCP_PROJECT があれば vertex）
AI_PROVIDER=vertex
# vertex のとき。認証は `gcloud auth login` 済みのアカウントを使う（キー不要）
GCP_PROJECT=your-gcp-project
GCP_ACCOUNT=you@example.com
# VERTEX_MODEL=google/gemini-3.5-flash
# nosana のとき
# NOSANA_BASE_URL=https://<your-nosana-endpoint>/v1
# NOSANA_MODEL=qwen3.5:9b  # 例: qwen3.5:9b / Qwen/Qwen2.5-VL-7B-Instruct
# OPERATOR_AI_PROVIDER=vertex  # 読み取り（AI_PROVIDER=nosana）と操作（vertex）を分担させるとき

# 隔離実行: daytona / gcp / docker / local（未指定なら DAYTONA_API_KEY があれば daytona、無ければ Docker デスクトップ。local は隔離なしの開発用）
# gcp は npm run gcp:up で VM を用意してから使う（GCP_PROJECT / GCP_ACCOUNT を使用。GCP_VM / GCP_ZONE で変更可）
# SANDBOX_PROVIDER=gcp
# 申請先（既定: 佐倉市「電子申請 体験」）
# TARGET_URL=https://apply.e-tumo.jp/city-sakura-chiba-u/offer/offerList_detail?tempSeq=36791
# ご家族の連絡先メールアドレス。申請先が連絡先を求めたときに使い、整理番号のメールが届く（未設定ならご本人に質問する）
# CONTACT_EMAIL=family@example.com
